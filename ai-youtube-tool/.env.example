# ============================================================
# AI YouTube Tool — Environment Variables EXAMPLE
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
POSTGRES_USER=aitube
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=aitube
# Docker: DATABASE_URL=postgresql+asyncpg://aitube:your_password@postgres:5432/aitube
# Local:
DATABASE_URL=postgresql+asyncpg://aitube:your_db_password_here@localhost:5432/aitube

# --- Redis ---
# Docker: REDIS_URL=redis://redis:6379/0
# Local:
REDIS_URL=redis://localhost:6379/0

# --- AI Providers ---
# Get your key at: https://fal.ai/dashboard
FAL_KEY=your_fal_api_key_here
AI_PROVIDER=fal

# --- Storage ---
# Docker: STORAGE_BASE_PATH=/app/storage
# Local:
STORAGE_BASE_PATH=../storage

# --- App Settings ---
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
